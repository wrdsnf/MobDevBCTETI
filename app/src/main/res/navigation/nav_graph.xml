<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment android:id="@+id/homeFragment"
        android:name="com.example.layoutbootcamp.HomeFragment"
        android:label="Home" >
        <action android:id="@+id/action_homeFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <action android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.layoutbootcamp.DetailFragment"
        android:label="Detail" >

        <argument
            android:name="title"
            app:argType="string" />

        <argument
            android:name="date"
            app:argType="string" />
    </fragment>


    <fragment android:id="@+id/profileFragment"
        android:name="com.example.layoutbootcamp.ProfileFragment"
        android:label="Profile" />

</navigation>